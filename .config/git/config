[user]
	name = Florian Kreibaum
	email = florian@ulysses.app
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[submodule]
	fetchJobs = 0
	recurse = true
[diff]
	tool = Kaleidoscope
[difftool]
	prompt = false
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path "$MERGED" -- "$LOCAL" "$REMOTE"
	trustExitCode = true
[merge]
	tool = Kaleidoscope
[mergetool]
	prompt = false
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output "$MERGED" --base "$BASE" -- "$LOCAL" --snapshot "$REMOTE" --snapshot
	trustExitCode = true
[fetch]
	prune = true
[alias]
	a    = add
	au   = add -u
	br   = branch
	c    = commit
	ca   = commit --amend
	can  = commit --amend --no-edit
	co   = checkout
	d    = diff
	ds   = diff --staged
	dt   = difftool
	dtd  = difftool --dir-diff
	f    = fetch
	fa   = fetch --all
	l    = pull
	lg   = log
	m    = merge
	p    = push
	pf   = push -f
	pu   = push -u origin HEAD
	rh   = reset --hard
	rs   = restore
	rst  = restore --staged
	s    = submodule
	su   = submodule update
	sui  = submodule update --init --recursive
	st   = status --renames
	sw   = switch
	wipe = !git reset --hard && git clean -df
	wipex = !git reset --hard && git clean -dfx
	w    = worktree
	wa   = worktree add
	wr   = worktree remove
